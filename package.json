{
  "name": "@kernhq/collab-service",
  "version": "0.1.0",
  "private": true,
  "description": "Kern collab service: Hocuspocus (Yjs) server for collaborative editing, persisted to Postgres, access via core",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "biome check . && node scripts/check-ranges.mjs package.json",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@kernhq/contracts": "^0.6.1",
    "@kernhq/kernel": "^0.7.0",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.32",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@hocuspocus/provider": "^4.6.0",
    "@kernhq/testing": "^0.1.0",
    "@kernhq/tsconfig": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "ws": "^8.21.0"
  }
}
