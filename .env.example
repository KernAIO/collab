# Collab service. Kernel-level variables (DATABASE_URL, NATS_URL, KERN_SECRET, CORE_URL…) are inherited
# from the umbrella .env in development.
PORT=4300
COLLAB_DEBOUNCE_MS=2000
COLLAB_MAX_DEBOUNCE_MS=15000
COLLAB_MAX_DOCUMENT_BYTES=8388608
COLLAB_SNAPSHOT_INTERVAL_MS=300000

# VALKEY_URL is what lets you run more than one collab process: the instances relay edits and
# presence through it, so no session affinity is needed. It is a kernel-level variable and the
# self-host, Coolify and cloud compose files already set it. Without it the service is one honest
# process, which is what a laptop wants.
#
# The prefix namespaces this deployment's channels and locks. Two Kern instances sharing one Valkey
# need two prefixes.
COLLAB_REDIS_PREFIX=kern:collab
